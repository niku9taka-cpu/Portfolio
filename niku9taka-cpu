<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>下谷 | ポートフォリオ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Yomogi&display=swap" rel="stylesheet">
<style>
:root {
  --sky: #4db8e8;
  --sky-light: #aee3f9;
  --grass: #6fbf4a;
  --grass-dark: #4e9b32;
  --sun: #ffd93b;
  --ink: #23402a;
  --paper: #fffef7;
}
* { box-sizing: border-box; }

body {
  font-family: "Yomogi", "Hiragino Maru Gothic ProN", "Hiragino Sans", "Yu Gothic", sans-serif;
  line-height: 1.9;
  font-size: 1.05rem;
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(ellipse 90% 340px at 50% -60px, rgba(255, 214, 120, .28), transparent 70%),
    linear-gradient(180deg, #d9f1fc 0%, #eaf8ec 30%, #d8f0bc 62%, #aede8d 100%);
  background-attachment: fixed;
}
/* ヘッダー：田舎の夏の空と丘 */
header {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 72px 20px 110px;
  background:
    linear-gradient(180deg, rgba(63,169,221,.45), rgba(135,206,235,.35) 45%, rgba(201,236,159,.55) 80%, rgba(121,196,79,.6)),
    url("data:image/jpeg;base64,") center 38% / cover no-repeat;
  color: #123c22;
}
header h1 {
  position: relative; z-index: 1;
  font-size: 2.6rem; margin: 0 0 6px; letter-spacing: .08em;
  text-shadow: 0 2px 0 rgba(255,255,255,.65);
}
header p { position: relative; z-index: 1; margin: 4px 0; font-weight: 600; }
header a {
  position: relative; z-index: 1;
  display: inline-block; margin-top: 10px; padding: 6px 20px;
  background: #fff; color: #1a7a3c; font-weight: 700; text-decoration: none;
  border-radius: 999px; box-shadow: 0 3px 8px rgba(35, 90, 40, .22);
}
header a:hover { background: #f2ffe9; }
main, footer { max-width: 820px; margin: 0 auto; padding: 8px 20px 24px; }
section { margin-top: 36px; }
h2 {
  display: inline-block; font-size: 1.35rem; margin: 0 0 14px; padding: 2px 16px 4px 12px;
  background: linear-gradient(transparent 62%, #bfe89a 62%);
  border-left: 6px solid var(--grass-dark);
}
section h3 { margin: 18px 0 8px; font-size: 1.05rem; color: #256b31; }
section ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
section ul.quals { display: block; }
section ul.quals li {
  background: transparent; border: none; box-shadow: none; border-radius: 0;
  padding: 2px 0 2px 4px; font-weight: 500; color: var(--ink);
}
section ul.quals li::before { content: "・"; color: var(--grass-dark); font-weight: 700; }
/* 経歴タイムライン */
.timeline { position: relative; margin-top: 10px; padding-left: 26px; }
.timeline::before {
  content: ""; position: absolute; left: 9px; top: 8px; bottom: 8px; width: 4px; border-radius: 4px;
  background: linear-gradient(180deg, var(--sky), var(--grass));
}
.tl-item { position: relative; margin-bottom: 22px; }
.tl-item:last-child { margin-bottom: 4px; }
.tl-item::before {
  content: ""; position: absolute; left: -25px; top: 10px; width: 14px; height: 14px; border-radius: 50%;
  background: #fff; border: 4px solid var(--grass-dark); box-shadow: 0 1px 4px rgba(31,64,33,.25); z-index: 1;
}
.tl-badge {
  display: inline-block; background: linear-gradient(135deg, #57ab3d, #79c44f); color: #fff;
  font-weight: 700; font-size: .95rem; letter-spacing: .08em;
  padding: 3px 16px; border-radius: 999px; box-shadow: 0 2px 6px rgba(46,109,35,.3); margin-bottom: 8px;
}
.tl-card {
  background: linear-gradient(160deg, #ffffff, #f4fbef);
  border: 1.5px solid #cfe8bd; border-radius: 14px;
  padding: 12px 16px; box-shadow: 0 3px 10px rgba(46,109,35,.1);
}
.tl-card p { margin: 0 0 8px; line-height: 1.75; }
.tl-card p:last-child { margin-bottom: 0; }
.tl-card strong { color: #d3382c; }

.profile-photo { position: relative; z-index: 3; width: 132px; height: 132px; margin: 0 auto 12px; }
.profile-photo img {
  width: 132px; height: 132px; object-fit: cover; border-radius: 50%;
  border: 4px solid #fff; box-shadow: 0 6px 18px rgba(23,68,102,.35); display: block;
}
.profile-photo .profile-photo-label { display: none; }
.profile-photo.empty {
  border: 3px dashed rgba(255,255,255,.9); border-radius: 50%;
  background: rgba(255,255,255,.22);
  display: flex; align-items: center; justify-content: center; text-align: center;
  color: #fff; font-size: .82rem; line-height: 1.45; text-shadow: 0 1px 3px rgba(23,68,102,.5);
}
.profile-photo.empty .profile-photo-label { display: block; }

.map-wrap { margin-top: 10px; border-radius: 14px; overflow: hidden; border: 1.5px solid #cfe8bd; box-shadow: 0 3px 10px rgba(46,109,35,.12); }
.map-wrap iframe { width: 100%; height: 300px; border: 0; display: block; }
.map-link { font-size: .9rem; margin-top: 8px; }

.map-wrap.outline { background: linear-gradient(180deg, #eef8ff, #f4fbef); text-align: center; padding: 14px 10px 6px; }

.lightbox {
  position: fixed; inset: 0; z-index: 100; display: none;
  align-items: center; justify-content: center;
  background: rgba(10, 25, 15, .88); padding: 18px; cursor: zoom-out;
}
.lightbox.open { display: flex; }
.lightbox img {
  max-width: 96vw; max-height: 92vh; border-radius: 12px;
  box-shadow: 0 12px 40px rgba(0,0,0,.5); object-fit: contain;
}
.lightbox .lb-close {
  position: absolute; top: 14px; right: 18px; width: 44px; height: 44px;
  border: none; border-radius: 50%; background: #fff; color: #23402a;
  font-size: 1.4rem; line-height: 1; cursor: pointer; box-shadow: 0 3px 10px rgba(0,0,0,.35);
}
.tl-photo img, .photo-card img { cursor: zoom-in; }
.gujo-outline { width: min(340px, 88%); height: auto; }
.gujo-label { font-size: 20px; font-weight: 700; fill: #256b31; }
.gifu-label { font-size: 17px; font-weight: 700; fill: #7d8b74; }

.photo-grid .photo-card {
  flex: 0 0 min(300px, 82%); scroll-snap-align: start;
  background: linear-gradient(165deg, #ffffff, #f2f9e9);
  border: 1.5px solid #cfe8bd; border-top: 5px solid var(--grass);
  border-radius: 16px; padding: 12px; box-shadow: 0 5px 14px rgba(31,64,33,.14);
}
.photo-grid .photo-card .tl-photo { margin-top: 0; }
.photo-grid .photo-card .tl-photo img { max-height: 200px; }
.photo-card .photo-caption { margin: 8px 2px 2px; font-size: .92rem; color: #47603c; }
.tl-photo { margin-top: 10px; }
.tl-photo img { width: 100%; max-height: 320px; object-fit: cover; border-radius: 10px; display: block; }
.tl-photo .tl-photo-label { display: none; }
.tl-photo.empty {
  border: 2px dashed #a8d08a; border-radius: 10px; background: rgba(255,255,255,.55);
  padding: 22px 10px; text-align: center; color: #5b7a4a;
}
.tl-photo.empty .tl-photo-label { display: block; line-height: 1.6; }

section ul li {
  background: #fff; border: 2px solid #a5dc85; color: #2c6620;
  padding: 5px 16px; border-radius: 999px; font-weight: 600;
  box-shadow: 0 2px 5px rgba(80, 140, 50, .12);
}
.works-grid {
  display: flex; gap: 16px; overflow-x: auto; padding: 6px 2px 16px;
  scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--grass-dark) #e4f3d2;
}
.works-grid::-webkit-scrollbar { height: 8px; }
.works-grid::-webkit-scrollbar-thumb { background: var(--grass-dark); border-radius: 999px; }
.works-grid::-webkit-scrollbar-track { background: #e4f3d2; border-radius: 999px; }
.works-grid .work { flex: 0 0 min(340px, 84%); scroll-snap-align: start; }
.slider-nav { display: flex; gap: 8px; justify-content: flex-end; margin: -6px 0 2px; }
.slider-nav button {
  width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--grass-dark);
  background: #fff; color: var(--grass-dark); font-size: 1.25rem; line-height: 1;
  font-family: inherit; cursor: pointer; box-shadow: 0 2px 6px rgba(80, 140, 50, .18);
}
.slider-nav button:hover { background: #eef9df; }
.work {
  background: linear-gradient(165deg, #fffef9 0%, var(--paper) 55%, #fdf3d0 100%); border: 1px solid #dcebc9; border-top: 6px solid var(--grass);
  border-radius: 14px; padding: 16px 20px 12px; margin: 0 0 4px;
  box-shadow: 0 4px 12px rgba(90, 140, 60, .10);
}
.work h3 { margin: 0 0 6px; color: #256b31; }
.work p { margin: 6px 0; }
.work p:last-child {
  display: inline-block; background: #eaf7dc; color: #33691e;
  font-size: .85rem; font-weight: 700; padding: 2px 12px; border-radius: 999px;
}
.in-progress .work { border-top-color: var(--sky); }
.in-progress .work h3 { color: #1665a0; }
.in-progress .work p:last-child { background: #e2f3fd; color: #155e8a; }
footer {
  color: #5c7a55; font-size: .9rem; text-align: center; padding-bottom: 36px;
}
main { position: relative; }
main::before {
  content: ""; position: absolute; left: 20px; right: 20px; bottom: -6px; height: 46px; z-index: -1;
  border-radius: 0 0 24px 24px;
  background: linear-gradient(180deg, transparent, rgba(255, 170, 80, .14));
}
a { color: #1665a0; }
</style>
</head>
