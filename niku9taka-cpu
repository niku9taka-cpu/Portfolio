<script>
document.querySelectorAll('.slider-nav').forEach(function(nav){
  var grid = nav.nextElementSibling;
  var step = function(){ var card = grid.querySelector('.work, .photo-card'); return card ? card.offsetWidth + 16 : 320; };
  nav.querySelector('.slide-prev').addEventListener('click', function(){
    if (grid.scrollLeft <= 4) { grid.scrollTo({left: grid.scrollWidth, behavior: 'smooth'}); }
    else { grid.scrollBy({left: -step(), behavior: 'smooth'}); }
  });
  nav.querySelector('.slide-next').addEventListener('click', function(){
    var max = grid.scrollWidth - grid.clientWidth;
    if (grid.scrollLeft >= max - 4) { grid.scrollTo({left: 0, behavior: 'smooth'}); }
    else { grid.scrollBy({left: step(), behavior: 'smooth'}); }
  });
});

var lb = document.getElementById('lightbox');
var lbImg = document.getElementById('lightbox-img');
document.querySelectorAll('.tl-photo img, .photo-card img, .profile-photo img').forEach(function(img){
  img.addEventListener('click', function(){
    lbImg.src = img.src; lbImg.alt = img.alt || '拡大写真';
    lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false');
  });
});
function closeLb(){ lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true'); lbImg.src = ''; }
lb.addEventListener('click', closeLb);
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeLb(); });
</script>

